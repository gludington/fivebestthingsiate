# Copy to .dev.vars for local development. DO NOT commit .dev.vars.
#
# Run loodingdongs-auth locally (npm run dev there, http://localhost:8787), register this app
# on http://localhost:8787/admin as a confidential client with
#   redirect URI:             http://localhost:4321/auth/callback
#   post-logout redirect URI: http://localhost:4321/
# and paste its credentials below.
ISSUER=http://localhost:8787
APP_URL=http://localhost:4321
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
