---
import Logo from './Logo.astro';

interface Props {
  current?: 'list' | 'groups';
}
const { current } = Astro.props;
const user = Astro.locals.user!;

const nav = [
  { key: 'list', href: '/', label: 'My list' },
  { key: 'groups', href: '/groups', label: 'Groups' },
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-10 backdrop-blur-xs bg-white/95">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 min-w-0" aria-label="The Five Best Things I Ate: my list">
        <Logo />
        <span class="hidden md:inline text-xl sm:text-2xl font-bold text-slate-900">The Five Best Things I Ate</span>
      </a>

      <nav class="flex items-center gap-1">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.key ? 'page' : undefined}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-colors',
              current === item.key ? 'bg-orange-50 text-orange-700' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center gap-3">
          {user.picture && (
            <img src={user.picture} alt={user.name || 'User'} class="w-8 h-8 rounded-full ring-2 ring-slate-200" />
          )}
          <span class="text-sm font-medium text-slate-700">{user.name || user.email}</span>
        </div>
        <form method="post" action="/auth/logout">
          <button
            type="submit"
            class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors"
          >
            Logout
          </button>
        </form>
      </div>
    </div>
  </div>
</header>
