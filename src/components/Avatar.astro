---
interface Props {
  name: string | null;
  email: string;
  picture: string | null;
  size?: 'sm' | 'md';
}
const { name, email, picture, size = 'sm' } = Astro.props;
const dims = size === 'md' ? 'w-12 h-12 text-lg' : 'w-8 h-8 text-sm';
const initial = (name || email).trim().charAt(0).toUpperCase();
---

{picture ? (
  <img src={picture} alt="" class:list={['rounded-full ring-2 ring-slate-200 object-cover', dims]} />
) : (
  <span class:list={['inline-flex items-center justify-center rounded-full bg-orange-100 font-semibold text-orange-700', dims]}>{initial}</span>
)}
